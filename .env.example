# ==============================================================================
# EASEContent Environment Configuration Template
# Copy to `.env` (for Docker Compose) and/or `backend/.env` (for local Node dev)
# NEVER commit real `.env` files or secrets to source control.
# ==============================================================================

# --- Application ---
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:5000
# Optional build-time API URL for the frontend container (leave empty when using Nginx /api proxy)
PUBLIC_API_URL=
WEB_HOST_PORT=8080
API_HOST_PORT=5000

# --- Database (MySQL 8+) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_HOST_PORT=3306
DB_NAME=easecontent
DB_USER=easecontent_user
DB_PASSWORD=replace_with_strong_db_password
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
# Set true only for fresh local/Docker dev initialization; use reviewed SQL migrations in production
DB_AUTO_SYNC=false
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0

# --- Cache & Background Job Queue (Redis / BullMQ) ---
# Leave REDIS_URL empty in local development to use the built-in in-process async worker.
# Set REDIS_URL (e.g. redis://127.0.0.1:6379 or redis://redis:6379) for multi-worker BullMQ execution.
REDIS_URL=
REDIS_HOST_PORT=6379
WORKER_CONCURRENCY=2

# --- Media Storage & FFmpeg Transcoding ---
MEDIA_STORAGE_DIR=storage/media
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23
MAX_PHOTO_UPLOAD_BYTES=26214400
MAX_VIDEO_UPLOAD_BYTES=536870912

# --- Authentication & Encryption ---
# Must be at least 32 random characters
JWT_SECRET=replace_with_at_least_32_random_characters_for_jwt_signing
# Optional dedicated 32+ char key for AES-256-GCM encryption of stored YouTube OAuth tokens (falls back to JWT_SECRET)
TOKEN_ENCRYPTION_KEY=replace_with_at_least_32_random_characters_for_token_encryption

# --- Transactional Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=EASEContent <onboarding@resend.dev>

# --- AI Services (Optional — graceful fallback included if unset) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- YouTube Data API v3 OAuth (Tied to Logged-In User Email) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev: http://localhost:5000/api/youtube/callback
# Docker Compose: http://localhost:8080/api/youtube/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/youtube/callback
