# EASEContent Backend Local Development Environment
# Copy to `backend/.env` and replace placeholder secrets before starting.

NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=easecontent
DB_USER=easecontent_user
DB_PASSWORD=replace_with_strong_db_password
DB_AUTO_SYNC=true

# Optional: set redis://127.0.0.1:6379 to run `npm run dev:worker` separately via BullMQ
REDIS_URL=
WORKER_CONCURRENCY=2

MEDIA_STORAGE_DIR=storage/media
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

JWT_SECRET=replace_with_at_least_32_random_characters_for_jwt_signing
TOKEN_ENCRYPTION_KEY=replace_with_at_least_32_random_characters_for_token_encryption

RESEND_API_KEY=
EMAIL_FROM=EASEContent <onboarding@resend.dev>

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/youtube/callback
