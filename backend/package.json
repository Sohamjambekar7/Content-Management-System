{
  "name": "easecontent-backend",
  "version": "2.0.0",
  "description": "EASEContent API server and async media processing worker",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx src/database/sync.ts"
  },
  "keywords": [
    "easecontent",
    "cms",
    "media-editor",
    "youtube"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^5.34.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "googleapis": "^188.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "resend": "^3.3.0",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.2",
    "@types/validator": "^13.15.10",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.0.8"
  }
}
